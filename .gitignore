# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Secrets
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# In-app dev feedback batches — transient working artifacts, not history.
# Keep the folders and README, ignore the batch files themselves.
feedback/incoming/*
feedback/processed/*
!feedback/incoming/.gitkeep
!feedback/processed/.gitkeep

# Screenshots from scripts/ui-responsive-audit.mjs. Regenerated on every run and
# only meaningful next to the run that produced them, so they are a working
# artifact rather than history — the same reasoning as the feedback batches above.
screenshots/

# One-off archive of the pilot workshop's evaluations, taken before the
# 2026-07-30 fresh start (tl-18). Real participant evidence — kept locally so the
# delete is recoverable, never committed.
.pilot-archive/

# Routing workspaces built from REAL workshop data by scripts/routing-batch.ts.
# Same reasoning as .pilot-archive/ above: a capture is an evaluator's candid
# assessment of a named colleague, and this repo is public. `routing/` is the
# committed workspace and holds synthetic captures only; anything generated from
# Postgres lands here and is moved to the PRIVATE routing repo by hand.
.routing-workspace/

# Roster scripts. This repo is public and code-searchable, and a roster script
# names real people with their email addresses in the clear. Applied scripts are
# archived in the private vault instead, under `Projects/OBT/OBT Consultant
# Track/`, alongside the ones from 2026-08-01 onward that already live there.
# A gitignore rule does not untrack what is already in history: the ones
# committed before 2026-08-24 (roster-20260818-*, tl25-*,
# tl30-*, src/data/seed.ts) are a separate backlog decision in the vault. This
# rule only stops the pile growing while that is decided.
scripts/roster-*.sql
